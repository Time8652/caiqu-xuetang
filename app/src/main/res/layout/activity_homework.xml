<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    tools:context=".CommunityFragment">

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@drawable/homework_and_points_top"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:letterSpacing="0.8"
        android:text="HOMEWORK"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textView_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF333333"
                android:textSize="13sp"
                android:text="标题"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="25dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="200dp"
                android:background="@drawable/edittext_8"
                android:textColor="#FFC7C7C7"
                android:textSize="12sp"
                android:text="请输入作业标题"
                android:lines="1"
                android:paddingLeft="10dp"
                android:layout_marginLeft="20dp"
                app:layout_constraintTop_toTopOf="@+id/textView_title"
                app:layout_constraintBottom_toBottomOf="@+id/textView_title"
                app:layout_constraintStart_toEndOf="@+id/textView_title"/>

            <TextView
                android:id="@+id/textView_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF333333"
                android:textSize="13sp"
                android:text="内容"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@+id/textView_title"
                app:layout_constraintStart_toStartOf="@+id/textView_title"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:background="@drawable/edittext_8"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="35dp"
                app:layout_constraintTop_toTopOf="@+id/textView_content"
                app:layout_constraintStart_toEndOf="@+id/textView_content"
                app:layout_constraintBottom_toTopOf="@+id/textView_deadline"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="14dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ai_picture"
                    android:scaleType="fitXY"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/view2"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFE8E3FF"
                    android:layout_marginTop="3dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/imageView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:textColor="#FFC7C7C7"
                    android:textSize="12sp"
                    android:text="请输入作业具体要求与内容"
                    android:minLines="1"
                    android:gravity="top"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/view2"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF333333"
                android:textSize="13sp"
                android:text="截止时间"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                app:layout_constraintStart_toStartOf="@+id/textView_content"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
                app:layout_constraintBottom_toTopOf="@+id/constraintLayout2"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/constraintLayout_deadline_day"
                android:layout_width="130dp"
                android:layout_height="25dp"
                app:cardCornerRadius="8dp"
                android:background="#FFFFFFFF"
                android:layout_marginLeft="15dp"
                app:layout_constraintTop_toTopOf="@+id/textView_deadline"
                app:layout_constraintBottom_toBottomOf="@+id/textView_deadline"
                app:layout_constraintStart_toEndOf="@+id/textView_deadline">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/deadline_day"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textColor="#FF333333"
                        android:textSize="13sp"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageView
                        android:id="@+id/imageView_day"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/baseline_access_time_24"
                        android:scaleType="fitXY"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/constraintLayout_deadline_time"
                android:layout_width="110dp"
                android:layout_height="25dp"
                app:cardCornerRadius="8dp"
                android:background="#FFFFFFFF"
                android:layout_marginLeft="10dp"
                app:layout_constraintTop_toTopOf="@+id/textView_deadline"
                app:layout_constraintBottom_toBottomOf="@+id/textView_deadline"
                app:layout_constraintStart_toEndOf="@+id/constraintLayout_deadline_day">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/deadline_time"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textColor="#FF333333"
                        android:textSize="13sp"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageView
                        android:id="@+id/imageView_time"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/baseline_calendar_month_24"
                        android:scaleType="fitXY"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/cancel"
                    android:layout_width="70dp"
                    android:layout_height="30dp"
                    android:background="@drawable/point_3"
                    android:gravity="center"
                    android:text="取消"
                    android:textColor="#FF999999"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@+id/save"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/save"
                    android:layout_width="70dp"
                    android:layout_height="30dp"
                    android:background="@drawable/point_1"
                    android:gravity="center"
                    android:text="保存"
                    android:textColor="#FF7E64FD"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@+id/send"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/cancel"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/send"
                    android:layout_width="70dp"
                    android:layout_height="30dp"
                    android:background="@drawable/point_2"
                    android:gravity="center"
                    android:text="布置"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/save"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>