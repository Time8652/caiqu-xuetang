<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#7E64FD">

    <View
        android:layout_width="match_parent"
        android:layout_height="530dp"
        android:background="@drawable/login_pattern"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_40"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/textView_welcom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="24sp"
            android:text="嗨~ 你来啦~"
            android:textStyle="bold"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="27dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        
        <View
            android:id="@+id/view"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:background="#7E64FD"
            android:layout_marginTop="9dp"
            app:layout_constraintStart_toStartOf="@+id/textView_welcom"
            app:layout_constraintTop_toBottomOf="@+id/textView_welcom"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/number"
            android:layout_width="350dp"
            android:layout_height="44dp"
            android:layout_marginTop="27dp"
            android:background="@drawable/edittext_16"
            app:layout_constraintTop_toBottomOf="@+id/view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:layout_width="21.5dp"
                android:layout_height="21.5dp"
                android:src="@drawable/login_account"
                android:layout_marginLeft="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            
            <EditText
                android:id="@+id/et_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#666666"
                android:textSize="14sp"
                android:text="请输入账号"
                android:background="#00FFFFFF"
                android:gravity="center_vertical"
                android:paddingLeft="50dp"
                android:textCursorDrawable="@drawable/cursor"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/password"
            android:layout_width="350dp"
            android:layout_height="44dp"
            android:background="@drawable/edittext_16"
            android:layout_marginTop="25dp"
            app:layout_constraintTop_toBottomOf="@+id/number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="21.5dp"
                android:layout_height="21.5dp"
                android:src="@drawable/login_password"
                android:layout_marginLeft="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#666666"
                android:textSize="14sp"
                android:text="请输入密码"
                android:inputType="textPassword"
                android:background="#00FFFFFF"
                android:gravity="center_vertical"
                android:paddingLeft="50dp"
                android:textCursorDrawable="@drawable/cursor"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/check1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@+id/number"
            app:layout_constraintEnd_toEndOf="@+id/number"
            app:layout_constraintTop_toBottomOf="@+id/password">

            <CheckBox
                android:id="@+id/checkBox1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:buttonTint="#00999999"
                android:text="自动登录"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/login_unchecked"
                android:layout_marginLeft="6.5dp"
                app:layout_constraintTop_toTopOf="@+id/checkBox1"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox1"
                app:layout_constraintStart_toStartOf="@+id/checkBox1"/>

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:buttonTint="#00999999"
                android:text="记住密码"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/login_check"
                android:layout_marginLeft="6.5dp"
                app:layout_constraintTop_toTopOf="@+id/checkBox2"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox2"
                app:layout_constraintStart_toStartOf="@+id/checkBox2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="登录"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:background="@drawable/horiz_purple"
            app:layout_constraintStart_toStartOf="@+id/number"
            app:layout_constraintEnd_toEndOf="@+id/number"
            app:layout_constraintTop_toBottomOf="@+id/check1"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="@+id/number"
            app:layout_constraintTop_toBottomOf="@+id/btn_login">

            <CheckBox
                android:id="@+id/checkBox3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"
                android:buttonTint="#00999999"
                android:text="已阅读并同意《"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/login_check"
                android:layout_marginLeft="6.5dp"
                app:layout_constraintTop_toTopOf="@+id/checkBox3"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox3"
                app:layout_constraintStart_toStartOf="@+id/checkBox3"/>

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7E64FD"
                android:textSize="13sp"
                android:text="服务条款"
                app:layout_constraintTop_toTopOf="@+id/checkBox3"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox3"
                app:layout_constraintStart_toEndOf="@+id/checkBox3"/>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="13sp"
                android:text="》和《"
                app:layout_constraintTop_toTopOf="@+id/checkBox3"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox3"
                app:layout_constraintStart_toEndOf="@+id/textView1"/>

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7E64FD"
                android:textSize="13sp"
                android:text="隐私权政策"
                app:layout_constraintTop_toTopOf="@+id/checkBox3"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox3"
                app:layout_constraintStart_toEndOf="@+id/textView2"/>

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="13sp"
                android:text="》"
                app:layout_constraintTop_toTopOf="@+id/checkBox3"
                app:layout_constraintBottom_toBottomOf="@+id/checkBox3"
                app:layout_constraintStart_toEndOf="@+id/textView3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>